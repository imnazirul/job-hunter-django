# Copy to backend-django/.env. docker-compose and the Django settings both read it.

DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
DJANGO_TIME_ZONE=UTC

POSTGRES_DB=jobhunter
POSTGRES_USER=jobhunter
POSTGRES_PASSWORD=jobhunter
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Managed hosts hand out one URL instead of the five values above. If it is set
# it wins, and the POSTGRES_* values are ignored.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

REDIS_URL=redis://redis:6379/0

# Set to 1 to run Celery tasks inline in the web process. Only for running tests
# or poking at the API without a worker; it hides real async behaviour.
CELERY_TASK_ALWAYS_EAGER=0

# Browser origins allowed to call the API directly. The web app proxies through
# its own server so it does not need this; the Electron renderer will.
CORS_ALLOWED_ORIGINS=http://localhost:3000

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT=60
# Sent as HTTP-Referer/X-Title so OpenRouter can attribute the traffic.
OPENROUTER_APP_URL=http://localhost:3000
OPENROUTER_APP_NAME=JobHunter

# Weak-model guardrails. Characters, not tokens, because we count what we can see.
LLM_CV_TEXT_LIMIT=6000
LLM_JOB_DESC_LIMIT=1200
LLM_SCORE_BATCH_SIZE=5
# How many of the highest rule-scored jobs get re-scored by the LLM per search.
LLM_SCORE_TOP_N=40

# --- Deployment only. Ignored locally; see README "Deploying to Railway". ---
# Railway injects RAILWAY_PUBLIC_DOMAIN itself and it is added to
# DJANGO_ALLOWED_HOSTS and CSRF_TRUSTED_ORIGINS automatically. Set these only
# for a custom domain or an extra one.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://api.example.com
# DJANGO_SECURE_SSL_REDIRECT=1
# SECURE_HSTS_SECONDS=0
# WEB_CONCURRENCY=2

# Job source keys. Empty means the source is skipped, not that the search fails.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=
USAJOBS_API_KEY=
USAJOBS_EMAIL=
RAPIDAPI_KEY=
